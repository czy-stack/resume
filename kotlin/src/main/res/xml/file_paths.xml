<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外置存储根目录 -->
    <external-path
        name="external_root"
        path="/" />
    <!-- 应用专属外部缓存：CameraActivity 在 Android 10 以下使用 -->
    <external-cache-path
        name="external_cache"
        path="." />
    <cache-path
        name="internal_cache"
        path="." />
</paths>
